# Copy this file to .env next to docker-compose.yml and change what you need.
# Every line is optional. A variable set in the shell wins over this file, and
# settings changed in the admin panel win over both until you reset them there.

# Serve the Citrine web app (true or false).
CITRINE_WEB=true

# Run the online relay at /relay, so friends can chat, share and play together (true or false).
CITRINE_RELAY=false

# Password people need to join the relay. With the relay on and no password the
# server refuses to start, unless you set CITRINE_RELAY_OPEN=true below.
CITRINE_RELAY_PASSWORD=

# Set to true to run the relay without a password, open to anyone who finds it.
CITRINE_RELAY_OPEN=false

# Password for the admin panel at /admin. Leave it empty to turn the panel off.
CITRINE_ADMIN_PASSWORD=

# Set to true to turn off two-factor sign-in for the admin panel at the next start,
# if you lost your phone and your recovery codes. Remove it again afterwards.
CITRINE_ADMIN_2FA_RESET=false

# Where the web app's files are. The Docker image puts them in ./static.
CITRINE_STATIC_DIR=./static

# Where the database and shared files are kept. Keep it on a volume.
CITRINE_DATA_DIR=./data

# Storage each user gets for screenshots and recordings shared in chat, in MB.
# 0 turns file sharing off.
CITRINE_STORAGE_MB=100

# Pass game files between friends who play together, so only one of them needs
# the game. Enabling this risks distributing games, so weigh it carefully for the
# context this relay runs in. It is also a big speedup: friends with different
# games can then play action games together, not only trade over the slow cable.
CITRINE_GAME_SHARING=false

# Port and address to listen on.
CITRINE_PORT=13707
CITRINE_BIND=0.0.0.0

# The address people use to reach this server, e.g. https://gb.example.com.
# Shown in the admin panel. Starting with https:// also marks the admin cookie Secure.
CITRINE_PUBLIC_URL=

# How many reverse proxies of your own sit in front of the server. The sign-in limits
# then count each visitor by the X-Forwarded-For entry that many from the right, or
# X-Real-IP, instead of the proxy's address. Leave it at 0 when nothing is in front,
# or anyone can pick their address by sending the header.
CITRINE_TRUSTED_PROXY_HOPS=0
