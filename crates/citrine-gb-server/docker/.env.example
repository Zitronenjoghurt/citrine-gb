# Copy this file to .env next to docker-compose.yml and change what you need.
# Every line is optional. A variable set in the shell wins over this file, and
# settings changed in the admin panel win over both until you reset them there.

# Serve the Citrine web app (true or false).
CITRINE_WEB=true

# Run the online relay at /relay, so friends can chat, share and play together (true or false).
CITRINE_RELAY=false

# Password people need to join the relay. With the relay on and no password the
# server refuses to start, unless you set CITRINE_RELAY_OPEN=true below.
CITRINE_RELAY_PASSWORD=

# Set to true to run the relay without a password, open to anyone who finds it.
CITRINE_RELAY_OPEN=false

# Password for the admin panel at /admin. Leave it empty to turn the panel off.
CITRINE_ADMIN_PASSWORD=

# Set to true to turn off two-factor sign-in for the admin panel at the next start,
# if you lost your phone and your recovery codes. Remove it again afterwards.
CITRINE_ADMIN_2FA_RESET=false

# Where the web app's files are. The Docker image puts them in ./static.
CITRINE_STATIC_DIR=./static

# Where the database and shared files are kept. Keep it on a volume.
CITRINE_DATA_DIR=./data

# Storage each user gets for cloud saves and for screenshots and recordings shared
# in chat, in MB. 0 turns file sharing off. Empty means 100, or 20 on a relay open
# to anyone (no password, invites off).
CITRINE_STORAGE_MB=

# Pass game files between friends who play together, so only one of them needs
# the game. Enabling this risks distributing games, so weigh it carefully for the
# context this relay runs in. It is also a big speedup: friends with different
# games can then play action games together, not only trade over the slow cable.
CITRINE_GAME_SHARING=false

# New accounts need an invite code made on the admin panel's Invites page (true or
# false). Game sharing only works while this is on. The panel can change it.
CITRINE_INVITES=false

# Limits that keep one person from using up the relay. The README lists them all.
# Data waiting to go out to one connection, in MB.
CITRINE_QUEUE_MB=8
# Seconds a send may wait on a connection that stopped reading.
CITRINE_SEND_TIMEOUT_SECS=20
# Files one connection downloads at once, and how many more may wait their turn.
CITRINE_DOWNLOADS_AT_ONCE=2
CITRINE_DOWNLOADS_WAITING=16
# Storage of all accounts together, database included, in MB. The panel can change it.
CITRINE_STORAGE_TOTAL_MB=10240
# Free disk the relay always leaves, in MB and as a share of the disk. The larger counts.
CITRINE_DISK_FLOOR_MB=2048
CITRINE_DISK_FLOOR_PERCENT=5
# Shared files and cloud save slots per account.
CITRINE_MAX_FILES=1000
CITRINE_MAX_SAVES=500
# Chat messages, and MB of them, one friend can leave for another who is offline.
CITRINE_INBOX_MESSAGES=2000
CITRINE_INBOX_MB=32
# Connections at once, in total and from one address, and how many from one
# address may wait to sign in.
CITRINE_MAX_CONNECTIONS=500
CITRINE_IP_CONNECTIONS=10
CITRINE_IP_UNSIGNED=3
# New connections from one address per minute.
CITRINE_IP_CONNECTS_PER_MINUTE=20
# KB one message may have before sign-in.
CITRINE_SIGN_IN_FRAME_KB=4
# Wrong relay passwords or invite codes per minute, per address and per account,
# and sign-ins with unknown keys per minute from one address.
CITRINE_WRONG_TRIES_PER_MINUTE=10
CITRINE_UNKNOWN_TRIES_PER_MINUTE=60
# Messages per second from one account, and how many it may send at once.
CITRINE_MESSAGES_PER_SECOND=30
CITRINE_MESSAGE_BURST=100
# Chat messages per second and at once, and KB of chat per second, per account.
CITRINE_CHATS_PER_SECOND=5
CITRINE_CHAT_BURST=30
CITRINE_CHAT_KB_PER_SECOND=256
# New friend requests per hour and at once, per account.
CITRINE_FRIEND_REQUESTS_PER_HOUR=20
CITRINE_FRIEND_REQUEST_BURST=10
# MB of files one account may download per day.
CITRINE_DOWNLOAD_MB_PER_DAY=1024
# KB per second and MB at once each player may send in a play session.
CITRINE_SESSION_KB_PER_SECOND=256
CITRINE_SESSION_BURST_MB=12
# Play invites one host may have waiting.
CITRINE_MAX_INVITES=5
# Relay password checks at once, and how many may wait.
CITRINE_PASSWORD_CHECKS=2
CITRINE_PASSWORD_QUEUE=16
# New accounts per hour from one address, and on the whole relay. Sign-ups with
# an invite code skip the second cap.
CITRINE_SIGN_UPS_PER_IP=3
CITRINE_SIGN_UPS_PER_HOUR=30
# Friend requests one account may have waiting, sent and received, and days a
# request waits for an answer.
CITRINE_FRIEND_REQUESTS_OUT=50
CITRINE_FRIEND_REQUESTS_IN=200
CITRINE_FRIEND_REQUEST_DAYS=30

# Port and address to listen on.
CITRINE_PORT=13707
CITRINE_BIND=0.0.0.0

# The address people use to reach this server, e.g. https://gb.example.com.
# Shown in the admin panel. Starting with https:// also marks the admin cookie Secure.
CITRINE_PUBLIC_URL=

# How many reverse proxies of your own sit in front of the server. The sign-in limits
# then count each visitor by the X-Forwarded-For entry that many from the right, or
# X-Real-IP, instead of the proxy's address. Leave it at 0 when nothing is in front,
# or anyone can pick their address by sending the header.
CITRINE_TRUSTED_PROXY_HOPS=0
