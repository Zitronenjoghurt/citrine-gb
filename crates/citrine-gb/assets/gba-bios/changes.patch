diff --git a/bios_calls/sound_bias.s b/bios_calls/sound_bias.s
new file mode 100644
index 0000000..ec71eab
--- /dev/null
+++ b/bios_calls/sound_bias.s
@@ -0,0 +1,56 @@
+swi_SoundBias:
+    @ moves the SOUNDBIAS level in steps of 2 towards 0 (r0 = 0) or 0x200, keeping the
+    @ resolution bits; the waits around each step follow the official BIOS's step times
+    @ (61 cycles down, 62 up), and r1 and r3 are left as it leaves them
+    mov r3, #0x04000000
+    add r3, #0x88
+    movs r1, r0
+    movne r1, #0x200
+    ldrh r2, [r3]
+    bic r2, #1
+    bic r12, r2, #0xfc00
+    bne .sound_bias_up
+    .sound_bias_down:
+        cmp r12, #0
+        beq .sound_bias_down_done
+        sub r2, #2
+        sub r12, #2
+        mov r0, #2
+        .sound_bias_down_wait:
+            subs r0, #1
+            bne .sound_bias_down_wait
+        strh r2, [r3]
+        mov r0, #11
+        .sound_bias_down_delay:
+            subs r0, #1
+            bne .sound_bias_down_delay
+        nop
+        nop
+        b .sound_bias_down
+    .sound_bias_up:
+        cmp r12, #0x200
+        bge .sound_bias_done
+        add r2, #2
+        add r12, #2
+        mov r0, #2
+        .sound_bias_up_wait:
+            subs r0, #1
+            bne .sound_bias_up_wait
+        strh r2, [r3]
+        mov r0, #11
+        .sound_bias_up_delay:
+            subs r0, #1
+            bne .sound_bias_up_delay
+        nop
+        nop
+        nop
+        b .sound_bias_up
+    .sound_bias_down_done:
+        .rept 3
+            nop
+        .endr
+    .sound_bias_done:
+        .rept 5
+            nop
+        .endr
+        bx lr
